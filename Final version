        "file_path = Path(\"/content/airalert-intelligence/data/raw/airalerts.json\")\n",
        "\n",
        "with open(file_path, \"r\", encoding=\"utf-8\") as f:\n",
        "    raw_data = json.load(f)\n",
        "\n",
