        "\n",
        "# AIRALERT INTELLIGENCE — 6-HOUR EXPERIMENTAL FORECAST\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import average_precision_score, brier_score_loss\n",
        "\n",
        "# Використовуємо лише дані до останнього неповного дня\n",
        "source = analysis_df.copy()\n",
        "source[\"start\"] = pd.to_datetime(source[\"start\"], utc=True)\n",
        "starts = source[\"start\"].dt.tz_convert(\"Europe/Kyiv\")\n",
        "\n",
        "hourly_index = pd.date_range(\n",
        "    starts.min().floor(\"h\"),\n",
        "    starts.max().floor(\"h\"),\n",
        "    freq=\"h\"\n",
        ")\n",
        "\n",
        "hourly = pd.DataFrame(index=hourly_index)\n",
        "hourly.index.name = \"forecast_time\"\n",
        "hourly[\"alert_starts\"] = (\n",
        "    pd.Series(1, index=starts)\n",
        "    .resample(\"h\")\n",
        "    .sum()\n",
        "    .reindex(hourly_index, fill_value=0)\n",
        ")\n",
        "\n",
        "# Ознаки використовують тільки попередні години\n",
        "hourly[\"hour_sin\"] = np.sin(2 * np.pi * hourly.index.hour / 24)\n",
        "hourly[\"hour_cos\"] = np.cos(2 * np.pi * hourly.index.hour / 24)\n",
        "hourly[\"weekday_sin\"] = np.sin(\n",
        "    2 * np.pi * hourly.index.dayofweek / 7\n",
        ")\n",
        "hourly[\"weekday_cos\"] = np.cos(\n",
        "    2 * np.pi * hourly.index.dayofweek / 7\n",
        ")\n",
        "\n",
        "for window in [1, 6, 24, 168]:\n",
        "    hourly[f\"past_{window}h\"] = (\n",
        "        hourly[\"alert_starts\"].shift(1).rolling(window).sum()\n",
        "    )\n",
        "\n",
        "# Мітка: чи була хоча б одна тривога в наступні 6 годин\n",
        "future_counts = sum(\n",
        "    hourly[\"alert_starts\"].shift(-step)\n",
        "    for step in range(1, 7)\n",
        ")\n",
        "hourly[\"target_next_6h\"] = (future_counts > 0).astype(float)\n",
        "\n",
        "# Останні 6 годин не мають повного майбутнього вікна\n",
        "hourly.loc[hourly.index[-6:], \"target_next_6h\"] = np.nan\n",
        "\n",
        "FEATURES = [\n",
        "    \"hour_sin\", \"hour_cos\", \"weekday_sin\", \"weekday_cos\",\n",
        "    \"past_1h\", \"past_6h\", \"past_24h\", \"past_168h\"\n",
        "]\n",
        "\n",
        "model_df = hourly.dropna(\n",
        "    subset=FEATURES + [\"target_next_6h\"]\n",
        ").copy()\n",
        "\n",
        "split = int(len(model_df) * 0.8)\n",
        "train = model_df.iloc[:split - 6]\n",
        "test = model_df.iloc[split:]\n",
        "\n",
        "if len(train) == 0 or len(test) == 0 or train[\"target_next_6h\"].nunique() < 2:\n",
        "    raise ValueError(\"Недостатньо даних для навчання. Перевір джерело.\")\n",
        "\n",
        "model = make_pipeline(\n",
        "    StandardScaler(),\n",
        "    LogisticRegression(max_iter=1000, class_weight=\"balanced\")\n",
        ")\n",
        "model.fit(train[FEATURES], train[\"target_next_6h\"].astype(int))\n",
        "\n",
        "test_prob = model.predict_proba(test[FEATURES])[:, 1]\n",
        "baseline_prob = np.full(len(test), train[\"target_next_6h\"].mean())\n",
        "\n",
        "print(\"ОЦІНКА НА ВІДКЛАДЕНОМУ ПЕРІОДІ\")\n",
        "print(\"Період тесту:\", test.index.min(), \"—\", test.index.max())\n",
        "print(\"Average Precision, модель:\",\n",
        "      round(average_precision_score(test[\"target_next_6h\"], test_prob), 3))\n",
        "print(\"Average Precision, baseline:\",\n",
        "      round(average_precision_score(test[\"target_next_6h\"], baseline_prob), 3))\n",
        "print(\"Brier score, модель:\",\n",
        "      round(brier_score_loss(test[\"target_next_6h\"], test_prob), 3))\n",
        "print(\"Brier score, baseline:\",\n",
        "      round(brier_score_loss(test[\"target_next_6h\"], baseline_prob), 3))\n",
        "\n",
        "# Прогноз після останньої доступної години в наборі\n",
        "latest = hourly.dropna(subset=FEATURES).iloc[[-1]]\n",
        "probability = model.predict_proba(latest[FEATURES])[0, 1]\n",
        "\n",
        "print(\"\\nЕКСПЕРИМЕНТАЛЬНА ОЦІНКА\")\n",
