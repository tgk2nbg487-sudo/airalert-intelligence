        "\n",
        "    # Якщо записи вкладені в один із ключів, покажемо структуру\n",
        "    records = None\n",
        "    for key, value in raw_data.items():\n",
        "        if isinstance(value, list):\n",
        "            records = value\n",
        "            print(\"Знайдено список записів у ключі:\", key)\n",
        "            break\n",
        "\n",
        "    if records is None:\n",
        "        records = [raw_data]\n",
        "else:\n",
        "    raise ValueError(\"Неочікуваний формат JSON\")\n",
        "\n",
        "print(\"Кількість записів:\", len(records))\n",
