      "cell_type": "code",
      "source": [
        "# Початок і завершення інтервалів переводимо до часу Києва\n",
        "starts = clean_df[\"start\"].dt.tz_convert(\"Europe/Kyiv\")\n",
        "\n",
        "# Годинна шкала в часовому поясі Києва\n",
        "hourly_index = pd.date_range(\n",
        "    start=starts.min().floor(\"h\"),\n",
        "    end=starts.max().ceil(\"h\"),\n",
        "    freq=\"h\",\n",
        ")\n",
        "\n",
        "hourly = pd.DataFrame(index=hourly_index)\n",
        "hourly.index.name = \"forecast_time\"\n",
        "\n",
        "# Кількість початків тривог у кожній годині\n",
        "hourly[\"alert_starts\"] = (\n",
        "    pd.Series(1, index=starts)\n",
        "    .resample(\"h\")\n",
        "    .sum()\n",
        "    .reindex(hourly_index, fill_value=0)\n",
        ")\n",
        "\n",
        "# Ціль: чи почалася хоча б одна тривога\n",
        "# у наступні 6 годин, не включаючи поточну годину\n",
        "future_starts = hourly[\"alert_starts\"].shift(-1)\n",
        "\n",
        "hourly[\"target_next_6h\"] = (\n",
        "    pd.concat(\n",
        "        [hourly[\"alert_starts\"].shift(-i) for i in range(1, 7)],\n",
        "        axis=1,\n",
        "    )\n",
        "    .sum(axis=1)\n",
        "    .gt(0)\n",
        "    .astype(\"int8\")\n",
        ")\n",
        "\n",
        "# Останні 6 годин не мають повного майбутнього вікна\n",
        "hourly.loc[hourly.index[-6:], \"target_next_6h\"] = pd.NA\n",
        "\n",
        "print(\"Кількість годин:\", len(hourly))\n",
        "print(\"\\nЧастка позитивних міток у доступному часовому ряді:\")\n",
        "print(\n",
        "    hourly[\"target_next_6h\"]\n",
        "    .dropna()\n",
        "    .mean()\n",
        "    .round(4)\n",
        ")\n",
        "\n",
        "display(hourly.head(10))\n",
        "display(hourly.tail(10))"
