      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Початки тривог переводимо в київський час\n",
        "starts = clean_df[\"start\"].dt.tz_convert(\"Europe/Kyiv\")\n",
        "\n",
        "# Годинний ряд\n",
        "hourly_index = pd.date_range(\n",
        "    starts.min().floor(\"h\"),\n",
        "    starts.max().ceil(\"h\"),\n",
        "    freq=\"h\",\n",
        ")\n",
        "\n",
        "hourly = pd.DataFrame(index=hourly_index)\n",
        "hourly.index.name = \"forecast_time\"\n",
        "\n",
        "# Кількість початків у кожній годині\n",
        "hourly[\"alert_starts\"] = (\n",
        "    pd.Series(1, index=starts)\n",
        "    .resample(\"h\")\n",
        "    .sum()\n",
        "    .reindex(hourly_index, fill_value=0)\n",
        ")\n",
        "\n",
        "# Ціль: хоча б один початок тривоги протягом наступних 6 годин\n",
        "future_counts = pd.concat(\n",
        "    [hourly[\"alert_starts\"].shift(-i) for i in range(1, 7)],\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "hourly[\"target_next_6h\"] = (\n",
        "    future_counts.gt(0).any(axis=1).astype(float)\n",
        ")\n",
        "\n",
        "# Останні 6 годин не мають повного вікна для оцінювання\n",
        "hourly.loc[hourly.index[-6:], \"target_next_6h\"] = np.nan\n",
        "\n",
        "# Ознаки календаря\n",
        "hourly[\"hour\"] = hourly.index.hour\n",
        "hourly[\"day_of_week\"] = hourly.index.dayofweek\n",
        "\n",
        "# Циклічне кодування часу: 23:00 близько до 00:00\n",
        "hourly[\"hour_sin\"] = np.sin(2 * np.pi * hourly[\"hour\"] / 24)\n",
        "hourly[\"hour_cos\"] = np.cos(2 * np.pi * hourly[\"hour\"] / 24)\n",
        "\n",
        "hourly[\"weekday_sin\"] = np.sin(\n",
        "    2 * np.pi * hourly[\"day_of_week\"] / 7\n",
        ")\n",
        "hourly[\"weekday_cos\"] = np.cos(\n",
        "    2 * np.pi * hourly[\"day_of_week\"] / 7\n",
        ")\n",
        "\n",
        "# Лише минулі спостереження, без поточної години\n",
        "past_counts = hourly[\"alert_starts\"].shift(1)\n",
        "\n",
        "for window in [6, 24, 168]:\n",
        "    hourly[f\"starts_previous_{window}h\"] = (\n",
        "        past_counts.rolling(window, min_periods=window).sum()\n",
        "    )\n",
        "\n",
        "# Чи були початки в попередню годину\n",
        "hourly[\"starts_previous_1h\"] = past_counts\n",
        "\n",
        "FEATURES = [\n",
        "    \"hour_sin\",\n",
        "    \"hour_cos\",\n",
        "    \"weekday_sin\",\n",
        "    \"weekday_cos\",\n",
        "    \"starts_previous_1h\",\n",
        "    \"starts_previous_6h\",\n",
        "    \"starts_previous_24h\",\n",
        "    \"starts_previous_168h\",\n",
        "]\n",
        "\n",
        "model_df = hourly.dropna(\n",
        "    subset=FEATURES + [\"target_next_6h\"]\n",
        ").copy()\n",
